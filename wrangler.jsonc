{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kenarnold-tools",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "tools.kenarnold.org", "custom_domain": true }],
  "assets": {
    "directory": "./"
  }
}
